+/* Cap the bytes MLX itself holds (live buffers it allocated plus its cache),
+ * leaving imported (no-copy) buffers out. A new allocation past the cap first
+ * trims the cache, then throws a runtime_error tagged "[mlx-transient-cap]".
+ * 0 turns the cap off. Metal only; elsewhere a no-op. Returns the previous cap.
+ * */
+MLX_API size_t set_transient_limit(size_t limit);
+
+/* Bytes of the active memory that are imported (no-copy) buffers. */
+MLX_API size_t get_external_memory();
+
+/* High-water of active memory minus external memory since the last
+ * reset_transient_peak. */
+MLX_API size_t get_transient_peak();
+
+/* Restart the transient high-water from the current transient level. */
+MLX_API void reset_transient_peak();
