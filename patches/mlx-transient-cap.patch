@@ -93,6 +93,12 @@ size_t MetalAllocator::set_memory_limit(size_t limit) {
   return limit;
 };
 
+size_t MetalAllocator::set_transient_limit(size_t limit) {
+  std::unique_lock lk(mutex_);
+  std::swap(limit, transient_limit_);
+  return limit;
+};
+
