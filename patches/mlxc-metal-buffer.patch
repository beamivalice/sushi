For the engine of our own: the Metal buffer of an evaluated array with the offset of its data in it, so that a
pass of ours binds MLX's buffer itself and memory MLX holds is not wired a second time; and whether a handle is
the buffer's only holder, so that an append to state MLX computed is written in place. Temporary: both go when
decode no longer reads memory that MLX holds.

diff --git a/mlx/c/array.cpp b/mlx/c/array.cpp
--- a/mlx/c/array.cpp
+++ b/mlx/c/array.cpp
@@ -622,6 +622,31 @@
   return 0;
 }
 
+extern "C" int _mlx_array_metal_buffer(
+    void** buffer,
+    size_t* offset,
+    const mlx_array arr) {
+  try {
+    const auto& a = mlx_array_get_(arr);
+    *buffer = const_cast<void*>(a.buffer().ptr());
+    *offset = a.offset();
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
+
+extern "C" int _mlx_array_is_donatable(bool* res, const mlx_array arr) {
+  try {
+    *res = mlx_array_get_(arr).is_donatable();
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
+
