+extern "C" int mlx_metal_command_buffer_count(size_t* res) {
+  try {
+    *res = mlx::core::metal::command_buffer_count();
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
+extern "C" int mlx_metal_set_max_mb_per_buffer(int* prev, int mb) {
+  try {
+    *prev = mlx::core::metal::set_max_mb_per_buffer(mb);
+  } catch (std::exception& e) {
+    mlx_error(e.what());
+    return 1;
+  }
+  return 0;
+}
